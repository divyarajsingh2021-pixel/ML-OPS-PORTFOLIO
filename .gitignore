# ------------------------------------------------------------------ Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/

# ------------------------------------------------------------------ Virtual environments
.venv/
venv/
env/

# ------------------------------------------------------------------ Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.log

# ------------------------------------------------------------------ Data (never commit datasets)
data/raw/*
data/interim/*
data/processed/*
!data/raw/.gitkeep
!data/interim/.gitkeep
!data/processed/.gitkeep

# ------------------------------------------------------------------ Models & runs (never commit binaries)
models/*
!models/.gitkeep
mlruns/
mlartifacts/
mlflow.db
mlflow.db-journal
mlflow.db-wal
mlflow.db-shm
*.joblib
*.pkl
*.onnx

# ------------------------------------------------------------------ Reports (keep figures/metrics small & curated)
reports/figures/*.png
!reports/figures/.gitkeep

# ------------------------------------------------------------------ Secrets
.env
.env.*
*.key
twitter_authentication.txt

# ------------------------------------------------------------------ OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/
